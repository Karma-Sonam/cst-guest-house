# Copy to an ignored .env.production on the deployment server.
POSTGRES_DB=guesthouse
POSTGRES_USER=guesthouse
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION=3600
PRODUCTION_ORIGIN=https://guesthouse.your-college.example
PRODUCTION_REGISTRATION_ENABLED=false
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8088
# Set both for initial administrator creation; remove both after first startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Verify actual operating hours with the property.
DINING_BREAKFAST_START=07:00
DINING_BREAKFAST_END=09:00
DINING_LUNCH_START=12:00
DINING_LUNCH_END=14:00
DINING_DINNER_START=18:00
DINING_DINNER_END=20:00
