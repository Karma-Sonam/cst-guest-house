# Host-level reverse proxy example. Replace the domain and certificate paths.
# The container stack should remain bound to 127.0.0.1:8088.
server {
    listen 80;
    server_name guesthouse.your-college.example;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name guesthouse.your-college.example;
    ssl_certificate /etc/letsencrypt/live/guesthouse.your-college.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/guesthouse.your-college.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
