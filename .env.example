# Copy to .env for local configuration. Never commit real credentials.
POSTGRES_DB=guesthouse
POSTGRES_PORT=55432
DATABASE_URL=jdbc:postgresql://localhost:55432/guesthouse
POSTGRES_USER=guesthouse
POSTGRES_PASSWORD=replace-with-local-password
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION=3600
FRONTEND_URL=http://127.0.0.1:5173,http://localhost:5173
ADMIN_EMAIL=
ADMIN_PASSWORD=
REGISTRATION_ENABLED=true
# Development scheduling defaults; verify with the property before production.
DINING_BREAKFAST_START=07:00
DINING_BREAKFAST_END=09:00
DINING_LUNCH_START=12:00
DINING_LUNCH_END=14:00
DINING_DINNER_START=18:00
DINING_DINNER_END=20:00

# Public guest-house contact details
GUESTHOUSE_PHONE=77217456
GUESTHOUSE_EMAIL=cstguesthouse@gmail.com
GUESTHOUSE_ADDRESS=Rinchendhing
