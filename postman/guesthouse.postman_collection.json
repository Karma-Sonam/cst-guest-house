{
  "info": {
    "name": "CST Guest House API",
    "description": "Run the Happy path folder only against local disposable test data. Set admin credentials in a private environment. Additional actions require appropriate states and are not a sequential runner flow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('guestEmail')) pm.environment.set('guestEmail', 'postman-' + Date.now() + '@example.test');",
          "if (!pm.environment.get('guestPassword')) pm.environment.set('guestPassword', 'Local-Postman-' + pm.variables.replaceIn('{{$guid}}'));",
          "const today = new Intl.DateTimeFormat('en-CA', {timeZone: 'Asia/Thimphu', year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());",
          "if (!pm.environment.get('checkIn')) pm.environment.set('checkIn', today);",
          "if (!pm.environment.get('checkOut')) pm.environment.set('checkOut', new Date(Date.parse(pm.environment.get('checkIn') + 'T00:00:00Z') + 86400000).toISOString().slice(0,10));",
          "if (!pm.environment.get('facilityDate')) pm.environment.set('facilityDate', pm.environment.get('checkOut'));"
        ]
      }
    }
  ],
